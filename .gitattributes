# Giữ LF cho mọi file text kể cả khi clone trên Windows (core.autocrlf=true),
# để script shell / file chạy trong container Linux không bị hỏng vì CRLF.
* text=auto eol=lf

# Script Windows cần CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# File nhị phân
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
*.xlsx binary
